# Внешние зависимости: это отдельные git-репозитории, подключённые через replace
# в nova-core/go.mod. В индекс их класть нельзя — получились бы gitlink-записи без
# .gitmodules. Как их получить, описано в инструкции по сборке.
/tools/amneziawg-go/
/tools/amneziawg-tools/
/tools/warp-plus/
/tools/amnezia-wg2-easy/
/tools/oblivion/

# Промежуточные сборки nova-core. В репозитории лежит только тот .aar, на который
# ссылается app/build.gradle.kts; остальные варианты пересоздаёт gomobile, и вместе
# они весят больше сотни мегабайт.
/app/libs/nova-core-api24.aar
/app/libs/nova-core-new.aar
/app/libs/classes.jar
/app/libs/*-sources.jar

# Настройки редакторов
/.continue/
/.vscode/

# Сторонний инструментарий и рабочие артефакты диагностики
/tools/jadx-1.5.5/
/tools/jadx-1.5.5.zip
/tools/probe/
/backups/
/Microsoft/
/.agents/

# Gradle
gradle-app.setting
!gradle-wrapper.jar
.gradletasker

# Ядро Xray: 34 МБ на архитектуру, генерируется nova-xray/build.sh.
# В репозитории лежат исходники (nova-xray/, tools/xray-core/), а не бинарники.
app/src/main/jniLibs/*/libnovaxray.so
app/src/main/jniLibs/*/libnovaxrayjni.so

# Keystore (не коммитим сами ключи)
*.jks
*.keystore
keystore.properties

