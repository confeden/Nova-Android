<?xml version="1.0" encoding="utf-8"?>
<!--
    Бегунок. Во включённом состоянии он НЕ красится в акцент: акцентный бегунок на
    акцентной дорожке сливался в сплошное пятно, и положение переключателя
    переставало читаться вовсе. Состояние должно быть видно и по цвету, и по
    положению — тогда подпись «ВКЛ» внутри не нужна.

    У неоновой темы включённый бегунок, наоборот, тёмный: там акцент светится, и
    белый кружок на нём пропадает. Поэтому цвет приходит атрибутом, а не константой.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="#5A6070" android:state_enabled="false"/>
    <item android:color="?attr/novaSwitchThumbOn" android:state_checked="true"/>
    <item android:color="?attr/novaSwitchThumbOff"/>
</selector>
