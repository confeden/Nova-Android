<?xml version="1.0" encoding="utf-8"?>
<!--
    Дорожка: включённая — акцент темы, выключенная — её же нейтральная подложка.
    Цвета приходят атрибутами (`values/attrs_nova_theme.xml`), а не литералами:
    иначе переключатель остаётся зелёным на золотой теме и выдаёт, что палитра
    единая только на словах.

    Прозрачности в выключенном состоянии нет намеренно: бегунок должен лежать на
    плотном фоне, иначе на светлых обоях он теряется.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="#1AFFFFFF" android:state_enabled="false"/>
    <item android:color="?attr/novaSwitchOn" android:state_checked="true"/>
    <item android:color="?attr/novaSwitchOff"/>
</selector>
