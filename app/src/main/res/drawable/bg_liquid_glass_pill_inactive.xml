<?xml version="1.0" encoding="utf-8"?>
<!--
  Неактивная пилюля: обычный вид и вид под фокусом пульта.

  На телевизоре указателя нет — без явной рамки непонятно, на чём стоишь.
  Отличаем не только цветом: рамка толще и подложка светлеет, чтобы выделение
  читалось и на плохой матрице, и при дальтонизме.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_focus_fill" />
            <corners android:radius="20dp" />
            <stroke android:width="3dp" android:color="@color/tv_focus_stroke" />
        </shape>
    </item>
    <item>
        <shape
            android:shape="rectangle">
            <solid android:color="#40100C1F" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
