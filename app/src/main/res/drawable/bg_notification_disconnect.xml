<?xml version="1.0" encoding="utf-8"?>
<!--
    Подложка кнопки «Отключить» в строке уведомления.

    Цвета литеральные: макет разворачивает SystemUI в своей теме, атрибутов
    `?attr/nova*` там не существует.

    Заливка **сплошная**, и это не вкусовщина. Полупрозрачная подложка берёт цвет
    у карточки уведомления, а карточка бывает и тёмной, и почти белой: на светлой
    шторке `#33FFFFFF` превращался в чуть заметное серое, а бледно-мятная подпись
    поверх него становилась нечитаемой. У сплошной заливки контраст с подписью
    один и тот же на любой шторке, потому что подложкой перестаёт быть чужая
    карточка. Тот же приём, что у `bg_notification_update.xml`.

    Скругление под скругление самой карточки.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FF10664A" />

    <corners android:radius="16dp" />

    <stroke
        android:width="1dp"
        android:color="#FF5AE282" />
</shape>
