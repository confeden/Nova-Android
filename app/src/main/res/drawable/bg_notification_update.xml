<?xml version="1.0" encoding="utf-8"?>
<!--
    Подложка уведомления об обновлении — нижний слой из трёх: сплошная тёмная
    основа. Над ней `bg_notification_update_glow.xml` (диагональная полоса) и
    `bg_notification_update_stroke.xml` (обводка).

    Цвета здесь только запасные: код красит каждый слой под акцент темы
    (`ImageView.setColorFilter`, `NovaNotificationPalette`), а режим SRC_ATOP
    меняет цвет и сохраняет альфу слоя — поэтому градиент полосы выражен
    прозрачностью, а не цветом. Литералы — прежний вид Aurora mint.

    Фон, а не сплошная заливка карточки: уведомление стоит в общей ленте рядом с
    системными, и единственное, чем оно может отличаться, — фон. Углы скруглены
    под скругление самой карточки уведомления. `<size>` нет намеренно — см.
    `bg_notification_disconnect.xml`.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FF0F3D2E" />

    <corners android:radius="14dp" />
</shape>
