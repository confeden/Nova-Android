<?xml version="1.0" encoding="utf-8"?>
<!--
    Обводка карточки обновления, верхний слой. Прозрачность 30 % зашита в сам
    слой: фильтр SRC_ATOP её сохраняет, и акцент любой темы ложится так же
    приглушённо, как прежний мятный.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#00000000" />

    <corners android:radius="14dp" />

    <stroke
        android:width="1dp"
        android:color="#4D5AE282" />
</shape>
