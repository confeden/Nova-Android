<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано tools/gen_nova_themes.py. Руками не править:
     правка переживёт ровно до следующего запуска генератора. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/novaFocusFill">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/novaFocusFill" />
                    <corners android:radius="14dp" />
                    <stroke android:width="3dp" android:color="?attr/novaFocusStroke" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/novaFocusFill" />
                    <corners android:radius="14dp" />
                    <stroke android:width="3dp" android:color="?attr/novaFocusStroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0BFFFFFF" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#1FA88DFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
