<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано tools/gen_nova_themes.py. Руками не править:
     правка переживёт ровно до следующего запуска генератора. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FFFFFF">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_focus_fill" />
                    <corners android:radius="12dp" />
                    <stroke android:width="3dp" android:color="@color/tv_focus_stroke" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_focus_fill" />
                    <corners android:radius="12dp" />
                    <stroke android:width="3dp" android:color="@color/tv_focus_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#38365D"
                        android:endColor="#2A2947"
                        android:type="linear" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#1FCCC2F5" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
