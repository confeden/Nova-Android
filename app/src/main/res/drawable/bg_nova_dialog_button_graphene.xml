<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано tools/gen_nova_themes.py. Руками не править:
     правка переживёт ровно до следующего запуска генератора. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_focus_fill" />
                    <corners android:radius="10dp" />
                    <stroke android:width="3dp" android:color="@color/tv_focus_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#26F0B429" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1dp" android:color="#F0B429" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
