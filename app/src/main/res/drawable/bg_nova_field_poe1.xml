<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано tools/gen_nova_themes.py. Руками не править:
     правка переживёт ровно до следующего запуска генератора. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/novaFocusFill" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="?attr/novaFocusStroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F2D1803" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#6E5A33" />
        </shape>
    </item>
</selector>
