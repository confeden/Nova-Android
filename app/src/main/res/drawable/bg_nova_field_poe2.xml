<!-- Сгенерировано tools/gen_nova_themes.py. Руками не править:
     правка переживёт ровно до следующего запуска генератора. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_focus_fill" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="@color/tv_focus_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#21BEC8D0" />
        </shape>
    </item>
</selector>
