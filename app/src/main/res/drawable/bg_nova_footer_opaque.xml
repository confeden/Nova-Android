<?xml version="1.0" encoding="utf-8"?>
<!--
    Подвал настроек: сплошная серая заливка, без обводки и без скруглений.

    Серый — тот же, что у карточки (`novaCardFill`), но уложенный на сплошной цвет низа
    экрана: сама заливка карточки полупрозрачна, и сквозь неё просвечивали строки списка,
    уходящие под подвал, и фон с фактурой.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/novaScreenBottom" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/novaCardFill" />
        </shape>
    </item>
</layer-list>
