<?xml version="1.0" encoding="utf-8"?>
<!--
    Подложка кнопки протокола/региона.

    Обводку выбранной кнопки этот файл больше не рисует: её вместе с неоновым
    ореолом рисует `FlowRadioGroup` цветом акцента текущей темы (`novaAccent`).
    Раньше цвета и радиус повторяли бейдж страны (`bg_country_badge.xml`) по
    просьбе владельца — «так же, как обводится зелёной линией бейдж», — но тем
    десять, и прибитый зелёный был бы верен ровно для одной. Отдельный файл, а
    не состояния внутри бейджа: тот же ресурс используется в списке конфигураций
    (`item_warp_config.xml`), и состояния изменили бы заодно и его.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Обводку выбранной кнопки рисует `FlowRadioGroup` цветом акцента текущей
        темы (`novaAccent`) вместе с ореолом: тем десять, и прибитый здесь
        зелёный был бы верен ровно для одной. Здесь остаётся только тело кнопки,
        и оно нейтрально-тёмное по той же причине.
    -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#3D0D1219" />
            <!-- Половина высоты кнопки (36dp) — то есть настоящий овал, а не
                 скруглённый прямоугольник. -->
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!--
        Невыбранная кнопка тоже обведена, только едва заметно: без рамки строка
        рассыпается на слова, и понять, где кончается одна кнопка и начинается
        соседняя, нельзя.
    -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
            <!-- Половина высоты кнопки (36dp) — то есть настоящий овал, а не
                 скруглённый прямоугольник. -->
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
