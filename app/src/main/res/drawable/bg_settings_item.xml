<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка настроек: обычный вид и вид под фокусом пульта.

  На телевизоре указателя нет, и пока фокус ничем не отмечен, по экрану непонятно,
  на чём стоишь. Отличаем не только цветом: рамка вдвое толще обычной и подложка
  светлеет — выделение читается и на плохой матрице, и при дальтонизме.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FFFFFF">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_focus_fill" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/tv_focus_stroke" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_focus_fill" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/tv_focus_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/liquid_glass_card_bg" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/liquid_glass_card_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
