<?xml version="1.0" encoding="utf-8"?>
<!--
    Круг «отключено».

    Не красный: красный на рабочем столе читается как ошибка, а выключенный VPN —
    не ошибка. Холодный графит с синим подсветом отличается от включённого
    состояния и не тревожит.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <gradient
        android:angle="270"
        android:startColor="#FF3A4756"
        android:endColor="#FF161D26"
        android:type="linear" />

    <stroke
        android:width="1.5dp"
        android:color="#FF8FA8C4" />
</shape>
