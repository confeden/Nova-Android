<?xml version="1.0" encoding="utf-8"?>
<!--
    Дорожка переключателя. Высота чуть больше бегунка, чтобы он лежал внутри, а не
    выпирал; ширина задаёт длину хода. Цвет приходит тинтом из состояния.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="52dp"
        android:height="29dp"/>
    <corners android:radius="15dp"/>
    <solid android:color="#FFFFFF"/>
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF"/>
</shape>
