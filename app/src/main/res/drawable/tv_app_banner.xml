<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#0E1725"
                android:startColor="#06111A" />
        </shape>
    </item>

    <item
        android:left="18dp"
        android:right="18dp"
        android:top="18dp"
        android:bottom="18dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#103646"
                android:startColor="#0A2330" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#2B7DA0" />
        </shape>
    </item>

    <!-- значок теперь адаптивный (XML): <bitmap> его не читает, поэтому слой берёт drawable напрямую -->
    <item
        android:width="132dp"
        android:height="132dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher" />
</layer-list>
