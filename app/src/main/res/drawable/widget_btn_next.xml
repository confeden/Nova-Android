<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка «следующий профиль»: сине-фиолетовый круг, чтобы не путать с
     питанием. Один рисунок вместо фона — причина в widget_btn_power_off. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <size android:width="48dp" android:height="48dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF8E7BFF"
                android:endColor="#FF2D2A6B"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#FFB6AEFF" />
        </shape>
    </item>

    <item
        android:left="13dp"
        android:top="13dp"
        android:right="13dp"
        android:bottom="13dp"
        android:drawable="@drawable/ic_widget_next" />
</layer-list>
