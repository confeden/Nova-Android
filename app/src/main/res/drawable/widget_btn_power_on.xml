<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка питания, «подключено»: тот же неоново-зелёный, что и у активного
     состояния экрана. Один рисунок вместо фона — причина в widget_btn_power_off. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <size android:width="48dp" android:height="48dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF4BE3A6"
                android:endColor="#FF0E7350"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#FF8CF0C0" />
        </shape>
    </item>

    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp"
        android:drawable="@drawable/ic_widget_power" />
</layer-list>
