<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Фон главного экрана"
            android:textColor="?attr/novaAccent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_background_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Анимация не реагирует на касания и экономит ресурсы."
            android:textColor="?attr/novaTextHint"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rg_main_background_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/novaCardBackground"
            android:orientation="vertical"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/rb_background_animation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/novaAccent"
                android:text="Использовать анимацию"
                android:textColor="?attr/novaTextTitle"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rb_background_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/novaAccent"
                android:text="Использовать изображение"
                android:textColor="?attr/novaTextTitle"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rb_background_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/novaAccent"
                android:text="Без фона"
                android:textColor="?attr/novaTextTitle"
                android:textSize="16sp" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
