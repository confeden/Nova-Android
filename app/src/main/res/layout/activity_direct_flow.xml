<?xml version="1.0" encoding="utf-8"?>
<!--
    Корень намеренно LinearLayout, а не ScrollView: RecyclerView внутри
    прокручиваемого контейнера теряет собственную высоту, и в activity_settings.xml
    это уже стоило фиксированных 520dp. Здесь список забирает остаток экрана весом.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Заголовок экрана -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Прямой поток"
        android:textColor="?attr/novaAccent"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Подсказка: главное про экран — правило действует во всех режимах -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Эти приложения идут мимо туннеля в любом режиме раздельного туннелирования. Изменения применяются к текущему сеансу."
        android:textColor="?attr/novaTextValue"
        android:textSize="12sp" />

    <!-- Мастер-переключатель закрытого российского списка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/novaCardBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Российские приложения мимо туннеля"
            android:textColor="?attr/novaTextTitle"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/sw_direct_russian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Живая сводка: сколько строк из списка и сколько выбрано руками -->
    <TextView
        android:id="@+id/tv_direct_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/novaTextHint"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_direct_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="?attr/novaAccent"
        android:hint="Поиск приложений..."
        android:inputType="text"
        android:textColor="?attr/novaTextTitle"
        android:textColorHint="?attr/novaTextHint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Системные приложения"
            android:textColor="?attr/novaTextTitle"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/sw_direct_show_system"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_direct_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

</LinearLayout>
