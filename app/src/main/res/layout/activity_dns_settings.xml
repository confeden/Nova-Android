<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройка DNS"
            android:textColor="?attr/novaAccent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dns_runtime_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Автовыбор DNS для VPN и приложений"
            android:textColor="?attr/novaTextHint"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/novaCardBackground"
            android:orientation="vertical"
            android:padding="12dp">

            <Switch
                android:id="@+id/sw_global_dns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Использовать свой DNS для VPN"
                android:textColor="?attr/novaTextTitle"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dns_rules_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Резолверы опрашиваются сверху вниз, все — шифрованные. Последняя строка — открытый резолвер провайдера: он отвечает, только когда не ответил ни один защищённый, и его можно выключить. Потяните строку за ручку слева, чтобы изменить порядок; нажмите — чтобы изменить адрес."
                android:textColor="?attr/novaTextHint"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_dns_rules"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="10dp"
                android:background="?attr/novaCardBackground"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/btn_add_dns_rule"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_settings_action_dark"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Добавить резолвер"
                android:textColor="?attr/novaTextTitle"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reset_dns_rules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:text="Сбросить к умолчаниям"
                android:textColor="?attr/novaAccent"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rg_dns_route_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <RadioButton
                    android:id="@+id/rb_dns_route_fastest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTO"
                    android:textColor="?attr/novaTextTitle" />

                <RadioButton
                    android:id="@+id/rb_dns_route_direct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Напрямую провайдеру"
                    android:textColor="?attr/novaTextTitle" />

                <RadioButton
                    android:id="@+id/rb_dns_route_tunnel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Через VPN"
                    android:textColor="?attr/novaTextTitle" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/novaCardBackground"
            android:orientation="vertical"
            android:padding="12dp">

            <Switch
                android:id="@+id/sw_app_override_dns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Отдельный DNS для приложения"
                android:textColor="?attr/novaTextTitle"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_selected_dns_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Выбрано приложение: пока не выбрано"
                android:textColor="?attr/novaTextTitle"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_pick_dns_app"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_action_dark"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Выбрать приложение"
                android:textColor="?attr/novaTextTitle"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_dns_app_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_settings_button"
                android:hint="Поиск приложения"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="?attr/novaTextTitle"
                android:textColorHint="?attr/novaTextHint"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_dns_apps"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="10dp"
                android:background="?attr/novaCardBackground"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/et_app_fallback_dns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_button"
                android:hint="DoH/DoT через запятую"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="?attr/novaTextTitle"
                android:textColorHint="?attr/novaTextHint" />

            <EditText
                android:id="@+id/et_app_primary_dns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_settings_button"
                android:hint="Обычный DNS через запятую"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="?attr/novaTextTitle"
                android:textColorHint="?attr/novaTextHint" />

            <Switch
                android:id="@+id/sw_app_plain_fallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:checked="true"
                android:text="Fallback на обычный DNS"
                android:textColor="?attr/novaTextTitle"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
