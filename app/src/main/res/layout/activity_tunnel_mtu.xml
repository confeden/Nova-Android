<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран «MTU туннеля».

    Раньше это была строка в настройках: заголовок, ползунок и подпись. Ползунок
    там шёл от 1000 до 1440 шагом 10 — сорок четыре положения на ширину экрана, то
    есть попасть пальцем в конкретное число было нельзя, а вернуться к заводскому
    1280 можно было только на глаз.

    Здесь то же самое, но с тремя недостающими вещами: поле для точного значения,
    кнопка «По умолчанию» и честный список транспортов. Регулировка показывается
    только там, где MTU действительно решает туннель, — остальные транспорты
    перечислены отдельно с причиной, по которой на них настройка не действует.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MTU туннеля"
            android:textColor="?attr/novaAccent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_mtu_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Размер пакета внутри туннеля. Меньше — больше пакетов на тот же объём; больше — пакет может не поместиться в канал и пропасть целиком."
            android:textColor="?attr/novaTextHint"
            android:textSize="12sp" />

        <!-- Карточка регулировки. Показывается только при поддерживаемом транспорте. -->
        <LinearLayout
            android:id="@+id/card_mtu_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/novaCardBackground"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_mtu_scope"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Действует сейчас"
                    android:textColor="?attr/novaTextTitle"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_mtu_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="1280"
                    android:textColor="?attr/novaAccent"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_tunnel_mtu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:progressTint="?attr/novaIconTint"
                android:thumbTint="?attr/novaIconTint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_mtu_min"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="600"
                    android:textColor="?attr/novaTextHint"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_mtu_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1440"
                    android:textColor="?attr/novaTextHint"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_mtu_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="?attr/novaTextHint"
                android:textSize="12sp" />

            <!-- Точное значение: ползунок в 84 положения пальцем не набирается. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_mtu_manual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/novaFieldBackground"
                    android:hint="Своё значение"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingLeft="12dp"
                    android:paddingTop="10dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="10dp"
                    android:textColor="?attr/novaTextTitle"
                    android:textColorHint="?attr/novaTextHint"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_mtu_apply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Применить"
                    android:textAllCaps="false"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_mtu_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="По умолчанию (1280)"
                android:textAllCaps="false"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Транспорты, у которых MTU решает не эта настройка. -->
        <LinearLayout
            android:id="@+id/card_mtu_unsupported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/novaCardBackground"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Где настройка не действует"
                android:textColor="?attr/novaTextTitle"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mtu_unsupported"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="?attr/novaTextHint"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_mtu_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="?attr/novaTextHint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
