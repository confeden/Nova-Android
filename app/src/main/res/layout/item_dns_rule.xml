<?xml version="1.0" encoding="utf-8"?>
<!--
    Одна строка списка резолверов.

    Порядок строк — это порядок опроса, поэтому ручка перетаскивания стоит первой
    и занимает всю высоту строки: тянут именно за неё, а не за строку целиком —
    нажатие на строку открывает редактирование.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingTop="6dp"
    android:paddingRight="4dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/iv_dns_rule_drag"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:contentDescription="Перетащить правило"
        android:padding="6dp"
        android:src="@drawable/ic_dns_drag_handle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_dns_rule_kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:minWidth="58dp"
                android:text="DoH"
                android:textColor="#50C878"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dns_rule_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:text="https://dns.example.com/dns-query"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_dns_rule_bootstrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:text="bootstrap: 1.1.1.1"
            android:textColor="#8A8A8A"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_dns_rule_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Включить правило" />

    <ImageView
        android:id="@+id/btn_dns_rule_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Удалить правило"
        android:padding="10dp"
        android:src="@drawable/ic_dns_rule_delete" />
</LinearLayout>
