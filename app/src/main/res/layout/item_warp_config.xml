<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_settings_item"
    android:backgroundTint="#161E1A"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/row_config_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_config_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_config_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="#50C878"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_config_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_country_badge"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="CURRENT"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_config_expand"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="⌄"
            android:textColor="#7EEA87"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/box_config_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_config_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:focusable="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:typeface="monospace" />
        <!-- Текст намеренно невыделяемый: textIsSelectable делает его фокусируемым
             и на пульте Android TV фокус застревает в нём, не доходя до кнопок.
             Для копирования есть отдельная кнопка. -->

        <!-- Перенос на вторую строку, когда кнопки не помещаются: в сумме им нужно
             около 412dp, а узкие экраны у́же — «Копировать» обрезалась. -->
        <com.example.nova.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btn_move_top"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_settings_action_dark"
                android:clickable="true"
                android:contentDescription="В начало списка"
                android:focusable="true"
                android:gravity="center"
                android:text="⤒"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_move_up"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_settings_action_dark"
                android:clickable="true"
                android:contentDescription="Выше"
                android:focusable="true"
                android:gravity="center"
                android:text="↑"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_move_down"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_settings_action_dark"
                android:clickable="true"
                android:contentDescription="Ниже"
                android:focusable="true"
                android:gravity="center"
                android:text="↓"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_move_bottom"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_settings_action_dark"
                android:clickable="true"
                android:contentDescription="В конец списка"
                android:focusable="true"
                android:gravity="center"
                android:text="⤓"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_delete_config"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_settings_action_dark"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="96dp"
                android:text="Удалить"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btn_copy_config"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_settings_action_dark"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="110dp"
                android:text="Копировать"
                android:textColor="#FFFFFF" />
        </com.example.nova.FlowLayout>
    </LinearLayout>

</LinearLayout>
