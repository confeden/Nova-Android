<?xml version="1.0" encoding="utf-8"?>
<!--
    Виджет: рамка со скруглёнными углами, внутри две круглые кнопки без подписей.

    Подписей нет намеренно — на две ячейки они не помещаются, не искажая круги, а
    смысл кнопок читается по значку и цвету: питание слева, перемотка профиля
    справа.

    Тело виджета прозрачное: рисуется только градиентная рамка и сами кнопки,
    сквозь остальное видны обои. Кнопки при этом непрозрачные — иначе значок в
    круге терялся бы на светлых обоях.

    Корень растянут на всю ячейку, рамка внутри — высотой по содержимому. Так
    виджет выглядит одинаково и в выделенной ему ячейке, и после растягивания:
    рамка тянется по ширине, а по высоте остаётся прежней и стоит по центру,
    вместо того чтобы превращаться в пустую коробку.

    **Кнопки не обрезаются, потому что уменьшаются.** Круг раньше был фоном вида,
    а фон рисуется по размеру вида: когда лаунчер отводил строку ниже, чем
    12+52+12 = 76dp, круги честно резались сверху и снизу. Теперь круг вместе со
    значком лежит в `src` (`widget_btn_power_off` и соседи), а вид объявлен
    `wrap_content` с `adjustViewBounds` и `fitCenter` — под тесным родителем
    ImageView уменьшает рисунок, сохраняя пропорции, вместо того чтобы обрезать
    его. Собственный размер рисунка 48dp, полный размер содержимого
    10+48+14+48+10 = 130dp на 10+48+10 = 68dp, и это уже помещается в строку
    везде, где помещалось прежнее объявление 2x1 из `widget_nova_info.xml`.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_widget_frame"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/widget_btn_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="Подключить или отключить Nova"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_btn_power_off" />

        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:adjustViewBounds="true"
            android:contentDescription="Следующий профиль"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_btn_next" />
    </LinearLayout>
</FrameLayout>
