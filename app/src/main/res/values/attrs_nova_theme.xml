<?xml version="1.0" encoding="utf-8"?>
<!--
    Словарь темы оформления.

    Смысл в том, чтобы разметка не знала ни одного цвета. Раньше их было 14 штук
    литералами по десяти файлам — четыре серых на одну роль, четыре зелёных на один
    акцент, семь кеглей на четыре смысла. Пока цвет прибит в разметке, «единая
    палитра» держится только на внимании, а внимание кончается на пятом экране.

    Значения приходят из `values/themes_nova.xml` (генерируется
    `tools/gen_nova_themes.py`), умолчания — из `Theme.Nova.Settings`, чтобы экран
    без явной темы не остался с нулями.

    Ролей текста ровно четыре, и больше заводить нельзя: пятая роль означает, что
    какая-то из четырёх используется не по назначению.
-->
<resources>

    <!-- Подложки. Ссылками, а не цветами: у тем разный радиус и разная толщина
         обводки, а прямоугольные панели Path of Exile — это не «почти как у всех»,
         а то, по чему тема узнаётся. -->
    <attr name="novaCardBackground" format="reference" />
    <attr name="novaFieldBackground" format="reference" />

    <!-- Подложки кнопок диалога. Нужны словарём, а не только стилем: кнопки
         приходится красить кодом (`NovaDialogs`) — на Pixel платформенный стиль
         кнопки диалога перебивает и фон, и оттенок, заданные темой. -->
    <attr name="novaDialogButton" format="reference" />
    <attr name="novaDialogButtonPrimary" format="reference" />

    <!-- Акцент — ровно один на тему. `novaAccentOn` — цвет текста поверх акцента:
         на светлом акценте белые буквы пропадают. -->
    <attr name="novaAccent" format="color" />
    <attr name="novaAccentDim" format="color" />
    <attr name="novaAccentOn" format="color" />

    <attr name="novaSeparator" format="color" />
    <attr name="novaCardFill" format="color" />
    <attr name="novaCardStroke" format="color" />

    <!-- Роль A — заголовок группы. Две точки градиента: заливка идёт шейдером по
         тексту (`NovaTheme.paintHeading`), а не картинкой. -->
    <attr name="novaTextGroupFrom" format="color" />
    <attr name="novaTextGroupTo" format="color" />

    <!-- Роль B — название пункта. -->
    <attr name="novaTextTitle" format="color" />
    <!-- Роль C — значение справа и пояснения. -->
    <attr name="novaTextValue" format="color" />
    <!-- Роль D — подпись под названием. -->
    <attr name="novaTextHint" format="color" />

    <attr name="novaSwitchOn" format="color" />
    <attr name="novaSwitchOff" format="color" />
    <attr name="novaSwitchThumbOn" format="color" />
    <attr name="novaSwitchThumbOff" format="color" />

    <attr name="novaIconTint" format="color" />

</resources>
