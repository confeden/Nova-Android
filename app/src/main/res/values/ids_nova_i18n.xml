    <item name="nova_i18n_text_source" type="id" />
    <item name="nova_i18n_text_output" type="id" />
    <item name="nova_i18n_hint_source" type="id" />
    <item name="nova_i18n_hint_output" type="id" />
    <item name="nova_i18n_cd_source" type="id" />
    <item name="nova_i18n_cd_output" type="id" />
    <item name="nova_i18n_verbatim" type="id" />
    <item name="nova_i18n_window_watch" type="id" />
</resources>
