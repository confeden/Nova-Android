+func (tun *netTun) ensureLocalAddressLocked(ip netip.Addr) error {
+	if !ip.IsValid() {
+		return errors.New("invalid netstack local address")
+	}
+	if _, exists := tun.localAddrs[ip]; exists {
+		return nil
+	}
+
+	var protoNumber tcpip.NetworkProtocolNumber
+	switch {
+	case ip.Is4():
+		protoNumber = ipv4.ProtocolNumber
+	case ip.Is6():
+		protoNumber = ipv6.ProtocolNumber
+	default:
+		return fmt.Errorf("unsupported netstack address family: %v", ip)
+	}
+
+	protoAddr := tcpip.ProtocolAddress{
+		Protocol:          protoNumber,
+		AddressWithPrefix: tcpip.AddrFromSlice(ip.AsSlice()).WithPrefix(),
+	}
+	if tcpipErr := tun.stack.AddProtocolAddress(1, protoAddr, stack.AddressProperties{}); tcpipErr != nil {
+		return fmt.Errorf("AddProtocolAddress(%v): %v", ip, tcpipErr)
+	}
+	tun.localAddrs[ip] = struct{}{}
+
+	if ip.Is4() && !tun.hasV4 {
+		tun.hasV4 = true
+		tun.stack.AddRoute(tcpip.Route{Destination: header.IPv4EmptySubnet, NIC: 1})
+	} else if ip.Is6() && !tun.hasV6 {
+		tun.hasV6 = true
+		tun.stack.AddRoute(tcpip.Route{Destination: header.IPv6EmptySubnet, NIC: 1})
+	}
+	return nil
+}
+
+func (net *Net) EnsureLocalAddress(ip netip.Addr) error {
+	tun := (*netTun)(net)
+	tun.addrMu.Lock()
+	defer tun.addrMu.Unlock()
+	return tun.ensureLocalAddressLocked(ip)
+}
+
 func (tun *netTun) Name() (string, error) {
 	return "go", nil
 }
