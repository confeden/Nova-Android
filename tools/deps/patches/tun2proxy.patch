+++ b/Cargo.toml
@@ -78,5 +78,17 @@
 chrono = "0.4.44"
 serde_json = "1.0.149"
 
-# [profile.release]
-# strip = "symbols"
+# Профиль выпуска: upstream держит его закомментированным, мы включаем.
+#
+# Отсюда убраны два очевидных рычага, и намеренно. `opt-level = "z"` жмёт код за
+# счёт скорости, а через эту библиотеку идёт **каждый пакет** режимов Opera и
+# VLESS — размер APK не стоит пропускной способности туннеля. `panic = "abort"`
+# меняет поведение: паника внутри cdylib убивала бы процесс `:vpn` целиком.
+#
+# Оставшиеся три и жмут, и обычно ускоряют: межмодульная оптимизация видит весь
+# граф, единственная единица кодогенерации не мешает ей, а символы в
+# библиотеке на устройстве не нужны никому.
+[profile.release]
+strip = "symbols"
+lto = "fat"
+codegen-units = 1
