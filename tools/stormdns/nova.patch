+package client
+
+import (
+	"sort"
+	"testing"
+)
+
+func conns(specs ...[3]int) []Connection {
+	out := make([]Connection, 0, len(specs))
+	for i, s := range specs {
+		out = append(out, Connection{Key: string(rune('a' + i)), IsValid: s[2] == 1, UploadMTUBytes: s[0], DownloadMTUBytes: s[1]})
+	}
+	return out
+}
+
+func TestNovaSelectDropsWeakKeepsFloor(t *testing.T) {
+	// MegaFon, 2026-09-29: op 84/936, op 106/896, NSDI 111/893, NSDI 111/657, Yandex 111/1200 x3.
+	got := novaSelectResolvers(conns(
+		[3]int{84, 936, 1}, [3]int{106, 896, 1}, [3]int{111, 893, 1}, [3]int{111, 657, 1},
+		[3]int{111, 1200, 1}, [3]int{111, 1200, 1}, [3]int{111, 1200, 1},
+	))
+	sort.Strings(got)
+	// 657 < 0.7*1200 and 84 < 0.8*111 are weak; the rest stay.
+	if len(got) != 2 || got[0] != "a" || got[1] != "d" {
+		t.Fatalf("dropped %v", got)
+	}
+}
+
+func TestNovaSelectNeverGoesBelowTwo(t *testing.T) {
+	got := novaSelectResolvers(conns([3]int{111, 1200, 1}, [3]int{60, 300, 1}, [3]int{60, 250, 1}))
+	if len(got) != 1 || got[0] != "c" {
+		t.Fatalf("dropped %v", got)
+	}
+	if got := novaSelectResolvers(conns([3]int{111, 1200, 1}, [3]int{60, 300, 1})); got != nil {
+		t.Fatalf("two resolvers must both stay, dropped %v", got)
+	}
+}
+
+func TestNovaSelectIgnoresInvalid(t *testing.T) {
+	got := novaSelectResolvers(conns([3]int{111, 1200, 1}, [3]int{111, 1100, 1}, [3]int{111, 100, 0}))
+	if got != nil {
+		t.Fatalf("dropped %v", got)
+	}
+}
+
+func TestNovaSelectJumboDoesNotEvictNormalResolvers(t *testing.T) {
+	// Mi A1 Wi-Fi 2026-09-29: direct 4000, Yandex 3603, Quad9 885, Google 1047, CF 882, router 879.
+	got := novaSelectResolvers(conns(
+		[3]int{111, 4000, 1}, [3]int{111, 3603, 1}, [3]int{111, 885, 1},
+		[3]int{111, 1047, 1}, [3]int{111, 882, 1}, [3]int{111, 879, 1}, [3]int{111, 650, 1},
+	))
+	if len(got) != 1 || got[0] != "g" {
+		t.Fatalf("only the 650 B resolver should go, dropped %v", got)
+	}
+}
