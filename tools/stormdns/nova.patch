diff --git a/internal/security/nova_dialect.go b/internal/security/nova_dialect.go
new file mode 100644
index 0000000..2443a77
--- /dev/null
+++ b/internal/security/nova_dialect.go
@@ -0,0 +1,39 @@
+// Nova dialect of the key derivation.
+//
+// A raw key that starts with NovaDialectPrefix is not hashed the stock way
+// (SHA-256 of the whole string) but through HMAC-SHA256 keyed by a Nova-only
+// constant. Stock StormDNS / MasterDnsVPN / CottenDNS / WhiteDNS clients that
+// were handed the same key string derive a different AES key, their packets
+// fail authentication and the server drops them without an answer — to them
+// the endpoint simply looks dead.
+//
+// Keys without the prefix derive exactly as upstream, so the same client binary
+// keeps working with third-party servers from user-imported links.
+//
+// This is not a secret against someone who reads Nova's source; it raises the
+// cost of reuse from "paste a link into any client" to "fork and keep up with
+// Nova's engine".
+package security
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"strings"
+)
+
+const NovaDialectPrefix = "nova1:"
+
+var novaDialectSalt = []byte("Nova/stormdns-dialect/v1/c3a9f1e27b5d4086")
+
+func novaDialectKey(rawKey string, targetLen int) ([]byte, bool) {
+	if !strings.HasPrefix(rawKey, NovaDialectPrefix) {
+		return nil, false
+	}
+	mac := hmac.New(sha256.New, novaDialectSalt)
+	mac.Write([]byte(rawKey[len(NovaDialectPrefix):]))
+	sum := mac.Sum(nil)
+	if targetLen <= 0 || targetLen > len(sum) {
+		targetLen = len(sum)
+	}
+	return sum[:targetLen], true
+}
diff --git a/internal/security/nova_dialect_test.go b/internal/security/nova_dialect_test.go
new file mode 100644
index 0000000..445c554
--- /dev/null
+++ b/internal/security/nova_dialect_test.go
@@ -0,0 +1,34 @@
+package security
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestNovaDialectDiffersFromStock(t *testing.T) {
+	raw := NovaDialectPrefix + "0123456789abcdef0123456789abcdef"
+	nova := deriveKey(5, raw)
+	stock, _ := novaDialectKey("x", 32) // no prefix -> not applied
+	if stock != nil {
+		t.Fatal("dialect applied without prefix")
+	}
+	a, _ := NewCodec(5, raw)
+	enc, err := a.Encrypt([]byte("hello"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A stock client handed the same string hashes it with SHA-256 of the whole key.
+	b := &Codec{method: 5}
+	stockKey := deriveKey(5, "stock:"+raw[len(NovaDialectPrefix):])
+	if bytes.Equal(nova, stockKey) || len(nova) != 32 {
+		t.Fatal("dialect key collides with stock derivation")
+	}
+	_ = b
+	if out, err := a.Decrypt(enc); err != nil || string(out) != "hello" {
+		t.Fatal("dialect roundtrip failed")
+	}
+	c, _ := NewCodec(5, raw[len(NovaDialectPrefix):])
+	if _, err := c.Decrypt(enc); err == nil {
+		t.Fatal("unprefixed key must not decrypt dialect traffic")
+	}
+}
