new file mode 100644
index 0000000..ed969f4
--- /dev/null
+++ b/internal/udpserver/nova_egress.go
@@ -0,0 +1,256 @@
+// Nova egress policy: what the tunnel refuses to carry.
+//
+// Every stream the server opens to the internet passes through dialTCPTargetContext,
+// and that is the only outbound path for client data (the server never relays UDP
+// except its own DNS lookups), so BitTorrent DHT/uTP are impossible by construction.
+// This file closes the TCP side:
+//
+//   - destinations resolve here, once, and every resolved address is checked, so a
+//     hostname cannot smuggle a private or blocked IP past validateSOCKSTargetHost;
+//   - IPs listed in NOVA_EGRESS_BLOCKLIST (Tor relays, refreshed by a timer outside
+//     the process) and a fixed set of ports (SMTP, BitTorrent defaults, Tor ORPort
+//     defaults) are refused;
+//   - the first bytes the client sends are sniffed: a BitTorrent peer handshake or
+//     an HTTP tracker announce closes the stream.
+//
+// Refusals are reported to the client as an ordinary blocked target — no reason.
+package udpserver
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	novaBlocklistEnv      = "NOVA_EGRESS_BLOCKLIST"
+	novaBlocklistDefault  = "/etc/stormdns/egress_block.txt"
+	novaBlocklistRecheck  = 60 * time.Second
+	novaSniffWindow       = 1024
+	novaResolveTimeoutCap = 5 * time.Second
+)
+
+var novaBlockedPorts = map[int]bool{
+	25: true, 465: true, 587: true, 2525: true, // SMTP
+	6881: true, 6882: true, 6883: true, 6884: true, 6885: true,
+	6886: true, 6887: true, 6888: true, 6889: true, 6969: true, 51413: true, // BitTorrent
+	9001: true, 9030: true, 9050: true, 9051: true, 9150: true, // Tor
+}
+
+type novaBlocklist struct {
+	mu      sync.RWMutex
+	set     map[netip.Addr]struct{}
+	path    string
+	modTime time.Time
+	checked atomic.Int64
+}
+
+var novaEgressBlocklist = &novaBlocklist{}
+
+func (b *novaBlocklist) contains(ip netip.Addr) bool {
+	b.maybeReload()
+	b.mu.RLock()
+	defer b.mu.RUnlock()
+	_, ok := b.set[ip.Unmap()]
+	return ok
+}
+
+func (b *novaBlocklist) maybeReload() {
+	now := time.Now().UnixNano()
+	last := b.checked.Load()
+	if last != 0 && now-last < int64(novaBlocklistRecheck) {
+		return
+	}
+	if !b.checked.CompareAndSwap(last, now) {
+		return
+	}
+	path := os.Getenv(novaBlocklistEnv)
+	if path == "" {
+		path = novaBlocklistDefault
+	}
+	st, err := os.Stat(path)
+	if err != nil {
+		return
+	}
+	b.mu.RLock()
+	same := b.path == path && b.modTime.Equal(st.ModTime())
+	b.mu.RUnlock()
+	if same {
+		return
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	set := make(map[netip.Addr]struct{}, 16384)
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		line := strings.TrimSpace(sc.Text())
+		if line == "" || line[0] == '#' {
+			continue
+		}
+		if ip, err := netip.ParseAddr(line); err == nil {
+			set[ip.Unmap()] = struct{}{}
+		}
+	}
+	// A truncated or empty file mid-write must not wipe a good list.
+	if sc.Err() != nil || len(set) == 0 {
+		return
+	}
+	b.mu.Lock()
+	b.set, b.path, b.modTime = set, path, st.ModTime()
+	b.mu.Unlock()
+}
+
+func novaAddrAllowed(ip netip.Addr) bool {
+	ip = ip.Unmap()
+	if !ip.IsGlobalUnicast() || ip.IsPrivate() || ip.IsLoopback() || ip.IsMulticast() ||
+		ip.IsLinkLocalUnicast() || ip.IsUnspecified() {
+		return false
+	}
+	if ip.Is4() {
+		b := ip.As4()
+		if b[0] == 100 && b[1] >= 64 && b[1] <= 127 { // CGNAT
+			return false
+		}
+		if b[0] == 198 && (b[1] == 18 || b[1] == 19) { // benchmarking
+			return false
+		}
+		if b[0] == 0 || b[0] >= 240 {
+			return false
+		}
+	}
+	return !novaEgressBlocklist.contains(ip)
+}
+
+// novaResolveTarget turns host:port into a list of permitted ip:port strings.
+// An empty list with a nil error never happens: either addresses or a block.
+func novaResolveTarget(ctx context.Context, address string, timeout time.Duration) ([]string, error) {
+	host, portStr, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil, err
+	}
+	port, err := strconv.Atoi(portStr)
+	if err != nil || port <= 0 || port > 65535 || novaBlockedPorts[port] {
+		return nil, &blockedSOCKSTargetError{host: host}
+	}
+	var addrs []netip.Addr
+	if ip, err := netip.ParseAddr(host); err == nil {
+		addrs = []netip.Addr{ip}
+	} else {
+		if timeout <= 0 || timeout > novaResolveTimeoutCap {
+			timeout = novaResolveTimeoutCap
+		}
+		rctx, cancel := context.WithTimeout(ctx, timeout)
+		defer cancel()
+		addrs, err = net.DefaultResolver.LookupNetIP(rctx, "ip", host)
+		if err != nil {
+			return nil, err
+		}
+	}
+	out := make([]string, 0, len(addrs))
+	for _, ip := range addrs {
+		if !novaAddrAllowed(ip) {
+			// One blocked answer taints the name: a relay that also resolves
+			// to a clean address is still a relay.
+			return nil, &blockedSOCKSTargetError{host: host}
+		}
+		out = append(out, net.JoinHostPort(ip.Unmap().String(), portStr))
+	}
+	if len(out) == 0 {
+		return nil, &blockedSOCKSTargetError{host: host}
+	}
+	return out, nil
+}
+
+func novaDial(ctx context.Context, address string, timeout time.Duration) (net.Conn, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	targets, err := novaResolveTarget(ctx, address, timeout)
+	if err != nil {
+		return nil, err
+	}
+	dialer := net.Dialer{Timeout: timeout}
+	var lastErr error
+	for _, t := range targets {
+		conn, err := dialer.DialContext(ctx, "tcp", t)
+		if err == nil {
+			return &novaSniffConn{Conn: conn}, nil
+		}
+		lastErr = err
+		if ctx.Err() != nil {
+			break
+		}
+	}
+	return nil, lastErr
+}
+
+var errNovaBlockedPayload = errors.New("connection closed")
+
+var (
+	novaBTHandshake = append([]byte{19}, []byte("BitTorrent protocol")...)
+	novaAnnounceMarks = [][]byte{[]byte("info_hash="), []byte("/announce"), []byte("/scrape?")}
+)
+
+// novaSniffConn inspects what the client writes until novaSniffWindow bytes
+// have gone out; after that it is a plain net.Conn.
+type novaSniffConn struct {
+	net.Conn
+	mu   sync.Mutex
+	seen []byte
+	done bool
+}
+
+func (c *novaSniffConn) Write(p []byte) (int, error) {
+	c.mu.Lock()
+	if !c.done {
+		room := novaSniffWindow - len(c.seen)
+		if room > len(p) {
+			room = len(p)
+		}
+		c.seen = append(c.seen, p[:room]...)
+		if novaPayloadBlocked(c.seen) {
+			c.done = true
+			c.seen = nil
+			c.mu.Unlock()
+			_ = c.Conn.Close()
+			return 0, errNovaBlockedPayload
+		}
+		if len(c.seen) >= novaSniffWindow {
+			c.done = true
+			c.seen = nil
+		}
+	}
+	c.mu.Unlock()
+	return c.Conn.Write(p)
+}
+
+func novaPayloadBlocked(b []byte) bool {
+	if bytes.HasPrefix(b, novaBTHandshake) {
+		return true
+	}
+	// Tracker announces are plain HTTP requests; the request line is enough.
+	if bytes.HasPrefix(b, []byte("GET ")) {
+		line := b
+		if i := bytes.IndexByte(b, '\n'); i >= 0 {
+			line = b[:i]
+		}
+		for _, m := range novaAnnounceMarks {
+			if bytes.Contains(line, m) && bytes.Contains(line, []byte("info_hash")) {
+				return true
+			}
+		}
+	}
+	return false
+}
