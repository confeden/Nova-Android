@@ -0,0 +1,51 @@
+package udpserver
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+	"time"
+)
+
+func TestNovaPayloadBlocked(t *testing.T) {
+	cases := map[string]bool{
+		"\x13BitTorrent protocol\x00\x00":                       true,
+		"GET /announce?info_hash=%12%34&peer_id=x HTTP/1.1\r\n": true,
+		"GET /scrape?info_hash=abc HTTP/1.1\r\n":                true,
+		"GET / HTTP/1.1\r\nHost: example.com\r\n":               false,
+		"\x16\x03\x01\x02\x00\x01":                              false,
+		"GET /search?q=info HTTP/1.1\r\n":                       false,
+	}
+	for in, want := range cases {
+		if got := novaPayloadBlocked([]byte(in)); got != want {
+			t.Errorf("%q: got %v want %v", in, got, want)
+		}
+	}
+}
+
+func TestNovaResolveTargetRefusals(t *testing.T) {
+	for _, a := range []string{"10.0.0.1:443", "127.0.0.1:80", "100.64.1.1:443", "1.1.1.1:25", "1.1.1.1:6881", "1.1.1.1:9001", "[::1]:443", "localhost:443"} {
+		if _, err := novaResolveTarget(context.Background(), a, 0); err == nil {
+			t.Errorf("%s: expected refusal", a)
+		}
+	}
+	if out, err := novaResolveTarget(context.Background(), "1.1.1.1:443", 0); err != nil || len(out) != 1 {
+		t.Errorf("1.1.1.1:443 refused: %v", err)
+	}
+	novaEgressBlocklist.mu.Lock()
+	novaEgressBlocklist.set = map[netip.Addr]struct{}{netip.MustParseAddr("1.0.0.1"): {}}
+	novaEgressBlocklist.mu.Unlock()
+	novaEgressBlocklist.checked.Store(1 << 62) // skip reload
+	if _, err := novaResolveTarget(context.Background(), "1.0.0.1:443", 0); err == nil {
+		t.Error("blocklisted address allowed")
+	}
+}
+
+func TestNovaSessionCeiling(t *testing.T) {
+	b := &novaBucket{tokens: 0, last: time.Now()}
+	start := time.Now()
+	b.take(novaSessionRateBytes / 4) // a quarter second of budget
+	if d := time.Since(start); d < 200*time.Millisecond || d > 400*time.Millisecond {
+		t.Fatalf("expected ~250ms wait, got %v", d)
+	}
+}
diff --git a/internal/udpserver/nova_ratelimit.go b/internal/udpserver/nova_ratelimit.go
new file mode 100644
index 0000000..2fc5882
--- /dev/null
+++ b/internal/udpserver/nova_ratelimit.go
@@ -0,0 +1,107 @@
+// Nova per-session speed ceiling.
+//
+// Every stream of one client session shares one token bucket, so a person gets at
+// most novaSessionRateBytes per second in total, however many connections the
+// phone opens. The number is the measured ceiling of the tunnel itself (5-7 Mbit/s
+// on the direct carrier from an EU host, 2026-09-29): nobody is slowed below what
+// the channel could give them alone, but one heavy user cannot take the whole box
+// from the others.
+//
+// Both directions draw from the same bucket; upload is ~0.3 Mbit/s at most over
+// DNS, so in practice this caps download.
+package udpserver
+
+import (
+	"net"
+	"sync"
+	"time"
+)
+
+const (
+	novaSessionRateBytes = 5_000_000 / 8 // 5 Mbit/s
+	novaSessionBurst     = 256 * 1024
+	novaBucketIdle       = 5 * time.Minute
+)
+
+type novaBucket struct {
+	mu     sync.Mutex
+	tokens float64
+	last   time.Time
+}
+
+var (
+	novaBucketsMu    sync.Mutex
+	novaBuckets      = map[uint8]*novaBucket{}
+	novaBucketsSwept time.Time
+)
+
+func novaBucketFor(session uint8) *novaBucket {
+	novaBucketsMu.Lock()
+	defer novaBucketsMu.Unlock()
+	now := time.Now()
+	if now.Sub(novaBucketsSwept) > time.Minute {
+		for id, b := range novaBuckets {
+			b.mu.Lock()
+			idle := now.Sub(b.last) > novaBucketIdle
+			b.mu.Unlock()
+			if idle {
+				delete(novaBuckets, id)
+			}
+		}
+		novaBucketsSwept = now
+	}
+	b := novaBuckets[session]
+	if b == nil {
+		b = &novaBucket{tokens: novaSessionBurst, last: now}
+		novaBuckets[session] = b
+	}
+	return b
+}
+
+// take blocks until n bytes fit under the ceiling. Debt is allowed (tokens may go
+// negative) so a read larger than the burst never waits forever; the wait is the
+// time the debt takes to refill.
+func (b *novaBucket) take(n int) {
+	if n <= 0 {
+		return
+	}
+	b.mu.Lock()
+	now := time.Now()
+	b.tokens += now.Sub(b.last).Seconds() * novaSessionRateBytes
+	if b.tokens > novaSessionBurst {
+		b.tokens = novaSessionBurst
+	}
+	b.last = now
+	b.tokens -= float64(n)
+	var wait time.Duration
+	if b.tokens < 0 {
+		wait = time.Duration(-b.tokens / novaSessionRateBytes * float64(time.Second))
+	}
+	b.mu.Unlock()
+	if wait > 0 {
+		time.Sleep(wait)
+	}
+}
+
+type novaRateConn struct {
+	net.Conn
+	bucket *novaBucket
+}
+
+func novaLimitSession(conn net.Conn, session uint8) net.Conn {
+	if conn == nil {
+		return nil
+	}
+	return &novaRateConn{Conn: conn, bucket: novaBucketFor(session)}
+}
+
+func (c *novaRateConn) Read(p []byte) (int, error) {
+	n, err := c.Conn.Read(p)
+	c.bucket.take(n)
+	return n, err
+}
+
+func (c *novaRateConn) Write(p []byte) (int, error) {
+	c.bucket.take(len(p))
+	return c.Conn.Write(p)
+}
