diff --git a/internal/client/nova_resolver_select.go b/internal/client/nova_resolver_select.go
new file mode 100644
index 0000000..434ce0c
--- /dev/null
+++ b/internal/client/nova_resolver_select.go
@@ -0,0 +1,97 @@
+// Nova resolver selection after MTU testing.
+//
+// The engine runs every stream with ONE download and ONE upload payload size:
+// the minimum over all accepted resolvers. One weak resolver therefore shrinks
+// every query of every other one. Measured on MegaFon LTE (2026-09-29): with 11
+// resolvers the synced download MTU fell to 650 B while most gave 880-1200 B.
+//
+// So a resolver whose MTU is far below the best is dropped — but only while at
+// least novaMinKeptResolvers remain, because on the same network each path is
+// also capped at ~6.4 KB/s by the operator and parallel paths add up. Dropping
+// is cheap to undo: the recheck loop may bring a resolver back later.
+package client
+
+import "sort"
+
+const (
+	novaDownloadKeepRatio = 0.70
+	novaUploadKeepRatio   = 0.80
+	novaMinKeptResolvers  = 2
+	// The download reference is capped at the common safe EDNS size: a direct
+	// carrier (4000 B) or Yandex (3603 B) must not raise the bar so high that
+	// every ~880-1047 B resolver is dropped — on Wi-Fi that threw out Quad9,
+	// the fastest path on MegaFon LTE (2026-09-29).
+	novaDownloadRefCap = 1232
+)
+
+// novaSelectResolvers returns the keys of valid connections to switch off.
+// Pure: it only reads the slice, so it is unit-testable.
+func novaSelectResolvers(connections []Connection) []string {
+	type cand struct {
+		key      string
+		up, down int
+	}
+	var valid []cand
+	maxUp, maxDown := 0, 0
+	for _, c := range connections {
+		if !c.IsValid {
+			continue
+		}
+		valid = append(valid, cand{c.Key, c.UploadMTUBytes, c.DownloadMTUBytes})
+		maxUp = max(maxUp, c.UploadMTUBytes)
+		maxDown = max(maxDown, c.DownloadMTUBytes)
+	}
+	if len(valid) <= novaMinKeptResolvers {
+		return nil
+	}
+	refDown := min(maxDown, novaDownloadRefCap)
+	weak := func(v cand) bool {
+		return float64(v.down) < novaDownloadKeepRatio*float64(refDown) ||
+			float64(v.up) < novaUploadKeepRatio*float64(maxUp)
+	}
+	// Weakest first, so if the floor stops us we have removed the worst ones.
+	sort.SliceStable(valid, func(i, j int) bool {
+		return valid[i].down*valid[i].up < valid[j].down*valid[j].up
+	})
+	var drop []string
+	kept := len(valid)
+	for _, v := range valid {
+		if kept <= novaMinKeptResolvers {
+			break
+		}
+		if weak(v) {
+			drop = append(drop, v.key)
+			kept--
+		}
+	}
+	return drop
+}
+
+// novaApplyResolverSelection switches the weak resolvers off in both the
+// connection list (which the MTU summary reads) and the balancer.
+func (c *Client) novaApplyResolverSelection() {
+	drop := novaSelectResolvers(c.connections)
+	if len(drop) == 0 {
+		return
+	}
+	dropSet := make(map[string]struct{}, len(drop))
+	for _, k := range drop {
+		dropSet[k] = struct{}{}
+	}
+	for i := range c.connections {
+		if _, ok := dropSet[c.connections[i].Key]; ok {
+			c.connections[i].IsValid = false
+			if c.balancer != nil {
+				c.balancer.SetConnectionValidity(c.connections[i].Key, false)
+			}
+			if c.log != nil {
+				c.log.Infof(
+					"Nova: resolver %s dropped as weak (upload=%d download=%d)",
+					c.connections[i].Key,
+					c.connections[i].UploadMTUBytes,
+					c.connections[i].DownloadMTUBytes,
+				)
+			}
+		}
+	}
+}
